APP_NAME="Discador THCONECT"
APP_ENV=production
APP_KEY=base64:GENERATE_A_UNIQUE_KEY_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://discador.example.com
APP_TIMEZONE=America/Sao_Paulo
LOG_CHANNEL=stack
LOG_LEVEL=warning
# Restrinja aos enderecos/CIDRs do proxy reverso Easypanel nesta VPS.
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12

INITIAL_ADMIN_NAME="Super Admin"
INITIAL_ADMIN_EMAIL=admin@discador.example.com
INITIAL_ADMIN_PASSWORD=CHANGE_ME_WITH_A_UNIQUE_STRONG_PASSWORD
# Use true only for a single controlled boot to synchronize an existing super admin password.
INITIAL_ADMIN_SYNC_PASSWORD=false

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=discador_thconect
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME_WITH_A_SECRET
DB_ROOT_PASSWORD=CHANGE_ME_WITH_A_DIFFERENT_SECRET
MYSQL_DATABASE=discador_thconect
MYSQL_USER=CHANGE_ME
MYSQL_PASSWORD=CHANGE_ME_WITH_A_SECRET
MYSQL_ROOT_PASSWORD=CHANGE_ME_WITH_A_DIFFERENT_SECRET

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME_WITH_A_SECRET
REDIS_CLIENT=predis

BROADCAST_CONNECTION=reverb
MAIL_MAILER=log

REVERB_APP_ID=CHANGE_ME
REVERB_APP_KEY=CHANGE_ME_WITH_A_RANDOM_PUBLIC_KEY
REVERB_APP_SECRET=CHANGE_ME_WITH_A_RANDOM_SECRET
REVERB_HOST=discador.example.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_BROADCAST_HOST=reverb
REVERB_BROADCAST_PORT=8080
REVERB_BROADCAST_SCHEME=http
REVERB_ALLOWED_ORIGINS=https://discador.example.com
REVERB_APP_RATE_LIMITING_ENABLED=true
REVERB_APP_RATE_LIMIT_MAX_ATTEMPTS=120
REVERB_APP_RATE_LIMIT_DECAY_SECONDS=60

# Use segredos longos e exclusivos. As credenciais AMI ficam criptografadas por empresa no banco.
ASTERISK_BRIDGE_URL=http://asterisk-bridge:8090
ASTERISK_BRIDGE_TOKEN=CHANGE_ME_WITH_A_LONG_RANDOM_TOKEN
ASTERISK_BRIDGE_WEBHOOK_SECRET=CHANGE_ME_WITH_A_DIFFERENT_LONG_RANDOM_TOKEN
# Gere com: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
ASTERISK_BRIDGE_STATE_KEY=CHANGE_ME_WITH_A_BASE64_32_BYTE_KEY
ASTERISK_BRIDGE_TIMEOUT=8

ASTERISK_AMI_USERNAME=thconect
ASTERISK_AMI_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
ASTERISK_RTP_START=12000
ASTERISK_RTP_END=12199
# IP publico fixo da VPS. Necessario para o SDP/RTP funcionar atras do NAT do Docker.
ASTERISK_EXTERNAL_MEDIA_ADDRESS=203.0.113.10
ASTERISK_EXTERNAL_SIGNALING_ADDRESS=203.0.113.10
ASTERISK_EXTERNAL_SIGNALING_PORT=5060
ASTERISK_ENABLE_TLS=false
# Necessario quando agentes estiverem atras de NAT. Exemplo: stun:stun.seudominio.com:3478
WEBRTC_STUN_URL=
# Mesmo servidor sem o prefixo "stun:" para o Asterisk.
ASTERISK_STUN_ADDRESS=
