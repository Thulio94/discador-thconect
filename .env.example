APP_NAME="Discador THCONECT"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8087
APP_TIMEZONE=America/Sao_Paulo
APP_PORT=8087
VITE_PORT=5187
MYSQL_FORWARD_PORT=3317
MYSQL_BIND_ADDRESS=127.0.0.1
REDIS_FORWARD_PORT=6387
REDIS_BIND_ADDRESS=127.0.0.1
REVERB_PORT=8097
REVERB_BIND_ADDRESS=127.0.0.1

# Gere valores aleatorios antes de habilitar uma rota Asterisk AMI real.
ASTERISK_BRIDGE_URL=http://asterisk-bridge:8090
ASTERISK_BRIDGE_TOKEN=
ASTERISK_BRIDGE_WEBHOOK_SECRET=
ASTERISK_BRIDGE_STATE_KEY=
ASTERISK_BRIDGE_TIMEOUT=8
ASTERISK_EXTERNAL_MEDIA_ADDRESS=
ASTERISK_EXTERNAL_SIGNALING_ADDRESS=
ASTERISK_EXTERNAL_SIGNALING_PORT=5060
ASTERISK_RTP_START=10000
ASTERISK_RTP_END=10199
ASTERISK_ENABLE_TLS=false
ASTERISK_AMI_HOST=asterisk
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USERNAME=thconect
ASTERISK_AMI_SECRET=change-me-before-real-calls
ASTERISK_SIP_PORT=5060

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
