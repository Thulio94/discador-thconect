ARG PHP_BASE_IMAGE=php:8.3-fpm
FROM ${PHP_BASE_IMAGE} AS base

ARG INSTALL_PHP_EXTENSIONS=true

RUN if [ "$INSTALL_PHP_EXTENSIONS" = "true" ]; then \
        apt-get update \
        && apt-get install -y --no-install-recommends libzip-dev libpng-dev libonig-dev libxml2-dev \
        && docker-php-ext-install pdo_mysql mbstring zip exif pcntl bcmath gd opcache \
        && apt-get clean \
        && rm -rf /var/lib/apt/lists/*; \
    fi

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

FROM base AS vendor

WORKDIR /app

COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --prefer-dist --optimize-autoloader --no-scripts

FROM node:22-alpine AS assets

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY resources ./resources
COPY public ./public
COPY vite.config.js ./
RUN npm run build

FROM base AS runtime

WORKDIR /var/www/html

COPY . ./
COPY --from=vendor /app/vendor ./vendor
COPY --from=assets /app/public/build ./public/build
COPY .docker/app/php.ini /usr/local/etc/php/conf.d/discador.ini
COPY .docker/entrypoint.production.sh /usr/local/bin/discador-entrypoint-production

RUN chmod +x /usr/local/bin/discador-entrypoint-production \
    && mkdir -p storage/app storage/framework/cache storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache

USER www-data

ENTRYPOINT ["discador-entrypoint-production"]
CMD ["php-fpm"]
